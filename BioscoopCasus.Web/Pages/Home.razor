@page "/"
@using BioscoopCasus.Web.Components
@inject MoviesOverviewService MoviesOverviewService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["HomeTitle"]</PageTitle>

<TerminalShell>
    <div class="terminal-header">
        <h1>@L["AppTitle"]</h1>
    </div>

    <div class="column">
        <h3>@L["LatestMovies"]</h3>
        @if (_movies == null)
        {
            <p class="empty-message">@L["Loading"]</p>
        }
        else if (!_movies.Any())
        {
            <p class="placeholder-text">@L["NoMoviesFound"]</p>
        }
        else
        {
            <div class="movie-grid">
                @foreach (var movie in _movies)
                {
                    <div class="movie-card clickable-card" @onclick="@(() => OpenMovie(movie.Id))">
                        <img src="https://placehold.co/200x250" alt="@movie.Title"/>
                        <div class="movie-card-info">
                            <h3>@movie.Title</h3>
                            <p class="movie-genres">@movie.Genres</p>
                            <p class="movie-duration">@movie.DurationMinutes @L["MinutesSuffix"]</p>
                        </div>
                    </div>
                }

            </div>
        }
        <TerminalButton Href="/movies" Text="@L["AllMovies"]" IsPrimary="true" />
    </div>

    <div class="column">
        <TerminalButton Href="/films" Text="@L["AllShowings"]" IsPrimary="true" />
    </div>
    
    <div class="column">
        <h3>@L["PrintTicket"]</h3>
        <TerminalButton Href="/ticketprint" Text="@L["PrintYourTicket"]" IsPrimary="true" />
    </div>
    
    <div class="column">
        <h3>@L["Location"]</h3>
        <p class="address-text">@L["CinemaAddress"]</p>
        <TerminalButton Href="https://www.google.com/maps/dir/?api=1&destination=Hogeschoollaan+1+Breda"
                        Target="_blank"
                        Rel="noopener noreferrer"
                        IsPrimary="true">
            <ChildContent>
                <div class="directions-btn-content">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                        <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
                    </svg>
                    <span>@L["Directions"]</span>
                </div>
            </ChildContent>
        </TerminalButton>
    </div>

    <div class="admin-login-wrapper">
        <TerminalButton Href="/login" IsPrimary="false" CssClass="admin-btn">
            <ChildContent>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                    <polyline points="10 17 15 12 10 7"></polyline>
                    <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
            </ChildContent>
        </TerminalButton>
    </div>
</TerminalShell>

@code{
    private List<MoviesOverviewDto>? _movies;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadMovies();
    }
    
    private async Task LoadMovies()
    {
        _movies = await MoviesOverviewService.GetMoviesAsync(DateTime.Now);
        // Make sure to only show 5 movies to avoid clutter
        if (_movies.Count > 0)
            _movies = _movies.Count < 5 ? _movies : _movies[..5];
    }
    
    private void OpenMovie(int movieId)
    {
        NavigationManager.NavigateTo($"/movies/{movieId}");
    }
}
