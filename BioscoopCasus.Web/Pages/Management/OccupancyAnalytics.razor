@page "/management/analytics/occupancy"
@attribute [Authorize]
@inject OccupancyAnalyticsService OccupancyAnalyticsService

<PageTitle>Bezettingsanalyse</PageTitle>

<div class="analytics-container">
    <div class="header-section">
        <a href="/management" class="back-link">Terug naar dashboard</a>
        <h1>Bezettingsanalyse</h1>
        <p class="subtitle">Basispagina voor zaal- en filmbelasting per gekozen periode.</p>
    </div>

    <div class="filters-grid">
        <div class="filter-item">
            <label>Vanaf</label>
            <input class="terminal-input" type="date" @bind="StartDate" @bind:format="yyyy-MM-dd" />
        </div>
        <div class="filter-item">
            <label>Tot en met</label>
            <input class="terminal-input" type="date" @bind="EndDate" @bind:format="yyyy-MM-dd" />
        </div>
        <div class="filter-item">
            <label>Filtertype</label>
            <select class="terminal-input" @bind="SelectedViewType">
                <option value="rooms">Zalen</option>
                <option value="movies">Films</option>
                <option value="both">Zalen en films</option>
            </select>
        </div>
    </div>

    <div class="placeholder-note">
        <strong>Basisstatus:</strong> deze pagina is bewust simpel gehouden. Volgende stap is data ophalen via de service en grafieken toevoegen met MudBlazor.
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <h3>Gemiddelde bezetting</h3>
            <p class="stat-value">--%</p>
        </div>
        <div class="stat-card">
            <h3>Best bezochte zaal</h3>
            <p class="stat-value">Nog niet gekoppeld</p>
        </div>
        <div class="stat-card">
            <h3>Best bezochte film</h3>
            <p class="stat-value">Nog niet gekoppeld</p>
        </div>
    </div>

    <div class="chart-section">
        <h2>Bezettingsgraaf</h2>
        <MudCard>
            <MudCardContent>
                <MudChart ChartType="ChartType.Bar" 
                          ChartSeries="@_series" 
                          XAxisLabels="@_xAxisLabels" 
                          Width="100%" 
                          Height="400px">
                </MudChart>
            </MudCardContent>
        </MudCard>
    </div>


<style>
    .analytics-container {
        max-width: 1000px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    .header-section {
        margin-bottom: 2rem;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 1rem;
        color: var(--text-muted);
        text-decoration: none;
    }

    .subtitle {
        color: var(--text-muted);
    }

    .filters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .filter-item {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .placeholder-note {
        border: 1px dashed rgba(255, 255, 255, 0.2);
        border-radius: 10px;
        padding: 1rem;
        margin-bottom: 1.5rem;
        color: var(--text-muted);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }

    .stat-card {
        background: var(--surface-glass);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 1rem;
    }

    .stat-value {
        margin-top: 0.5rem;
        font-weight: 700;
        color: var(--text-high);
    }

    .chart-section {
        margin-top: 3rem;
    }

    .chart-section h2 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        color: var(--text-high);
    }
</style>

@code {
    private DateTime StartDate { get; set; } = DateTime.Today.AddDays(-7);
    private DateTime EndDate { get; set; } = DateTime.Today;
    private string SelectedViewType { get; set; } = "both";

    // Chart data
    private List<ChartSeries> _series = new();
    private string[] _xAxisLabels = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };

    protected override void OnInitialized()
    {
        _ = OccupancyAnalyticsService;
        InitializeChartData();
    }

    private void InitializeChartData()
    {
        _series = new List<ChartSeries>
        {
            new ChartSeries { Name = "Room A", Data = new double[] { 65, 59, 80, 81, 56, 85, 72 } },
            new ChartSeries { Name = "Room B", Data = new double[] { 28, 48, 40, 19, 86, 27, 90 } },
            new ChartSeries { Name = "Room C", Data = new double[] { 45, 65, 52, 73, 38, 91, 64 } }
        };
    }
}

</div>








