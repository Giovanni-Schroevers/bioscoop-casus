@page "/management/analytics/revenue"
@attribute [Authorize]
@inject RevenueAnalyticsService RevenueAnalyticsService

<PageTitle>Omzetanalyse</PageTitle>

<div class="analytics-container">
    <div class="header-section">
        <a href="/management" class="back-link">Terug naar dashboard</a>
        <h1>Omzetanalyse</h1>
        <p class="subtitle">Basispagina voor omzetcijfers per film in een gekozen periode.</p>
    </div>


    @if (_isLoading)
    {
        <div class="loading-state">
            <span class="loading-spinner"></span>
            <p>Gegevens laden...</p>
        </div>
    }
    else if (_data is not null)
    {
        <div class="stats-grid">
            <div class="stat-card">
                <h3>Totale omzet</h3>
                <p class="stat-value">@FormatCurrency(_data.TotalRevenue)</p>
            </div>
            <div class="stat-card">
                <h3>Film met hoogste omzet</h3>
                <p class="stat-value">@(_data.TopMovieTitle ?? "Geen data")</p>
            </div>
            <div class="stat-card">
                <h3>Gemiddelde omzet per dag</h3>
                <p class="stat-value">@FormatCurrency(_data.AverageRevenuePerDay)</p>
            </div>
        </div>

        @if (_series.Count > 0)
        {
            <div class="chart-section">
                <h2>Omzet over tijd</h2>
                <MudCard>
                    <MudCardContent>
                        <MudChart ChartType="ChartType.Line"
                                  ChartSeries="@_series"
                                  XAxisLabels="@_xAxisLabels"
                                  Width="100%"
                                  Height="400px">
                        </MudChart>
                    </MudCardContent>
                </MudCard>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <p>Geen omzetgegevens gevonden.</p>
        </div>
    }
</div>

<style>
    .analytics-container {
        max-width: 1000px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    .header-section {
        margin-bottom: 2rem;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 1rem;
        color: var(--text-muted);
        text-decoration: none;
    }

    .subtitle {
        color: var(--text-muted);
    }


    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }

    .stat-card {
        background: var(--surface-glass);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 1rem;
    }

    .stat-value {
        margin-top: 0.5rem;
        font-weight: 700;
        color: var(--text-high);
    }

    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 0;
        gap: 1.5rem;
    }

    .loading-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid rgba(255, 255, 255, 0.1);
        border-top-color: var(--primary-rose);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .chart-section {
        margin-top: 2rem;
    }

    .chart-section h2 {
        font-size: 1.4rem;
        margin-bottom: 1rem;
        color: var(--text-high);
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: var(--text-muted);
        background: var(--surface-glass);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
    }
</style>

@code {
    private bool _isLoading;
    private RevenueAnalyticsResponseDto? _data;
    private List<ChartSeries> _series = new();
    private string[] _xAxisLabels = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;

        try
        {
            var filter = new AnalyticsPeriodRequestDto(DateTime.MinValue, DateTime.MaxValue, "day");
            _data = await RevenueAnalyticsService.GetRevenueAsync(filter);
            BuildChart();
        }
        catch
        {
            _data = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void BuildChart()
    {
        if (_data?.Items is not { Count: > 0 })
        {
            _series = new();
            _xAxisLabels = Array.Empty<string>();
            return;
        }

        _xAxisLabels = _data.Items.Select(i => i.Label).ToArray();
        _series = new List<ChartSeries>
        {
            new ChartSeries
            {
                Name = "Omzet",
                Data = _data.Items.Select(i => (double)i.Revenue).ToArray()
            }
        };
    }

    private static string FormatCurrency(decimal amount)
    {
        return $"\u20AC {amount:N2}";
    }
}


