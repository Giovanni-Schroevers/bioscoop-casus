@page "/management/analytics/revenue"
@attribute [Authorize]
@inject RevenueAnalyticsService RevenueAnalyticsService
@inject NavigationManager NavigationManager

<PageTitle>Omzetanalyse</PageTitle>

<div class="analytics-container">
    <div class="header-section">
        <button class="return-button" @onclick="@(() => NavigationManager.NavigateTo("/management"))">
            <span class="return-button-icon">&larr;</span>
            <span>Terug naar beheerdashboard</span>
        </button>
        <h1>Omzetanalyse</h1>
        <p class="subtitle">Totaaloverzicht van alle omzetcijfers.</p>
    </div>


    @if (_isLoading)
    {
        <div class="loading-state">
            <span class="loading-spinner"></span>
            <p>Gegevens laden...</p>
        </div>
    }
    else if (_data is not null)
    {
        <div class="stats-grid">
            <div class="stat-card">
                <h3>Totale omzet</h3>
                <p class="stat-value">@FormatCurrency(_data.TotalRevenue)</p>
            </div>
            <div class="stat-card">
                <h3>Film met hoogste omzet</h3>
                <p class="stat-value">@(_data.TopMovieTitle ?? "Geen data")</p>
            </div>
            <div class="stat-card">
                <h3>Gemiddelde omzet per dag</h3>
                <p class="stat-value">@FormatCurrency(_data.AverageRevenuePerDay)</p>
            </div>
        </div>

        <div class="charts-grid">
            @if (_series.Count > 0)
            {
                <div class="chart-section">
                    <h2>Omzet over tijd</h2>
                    <div class="chart-card">
                        <MudChart ChartType="ChartType.Line"
                                  ChartSeries="@_series"
                                  XAxisLabels="@_xAxisLabels"
                                  Width="100%"
                                  Height="350px">
                        </MudChart>
                    </div>
                </div>
            }

            @if (_movieSeries.Count > 0)
            {
                <div class="chart-section">
                    <h2>Top 5 films op omzet</h2>
                    <div class="chart-card">
                        <MudChart ChartType="ChartType.Bar"
                                  ChartSeries="@_movieSeries"
                                  XAxisLabels="@_movieLabels"
                                  Width="100%"
                                  Height="350px">
                        </MudChart>
                    </div>
                </div>
            }

            @if (_roomSeries.Count > 0)
            {
                <div class="chart-section">
                    <h2>Omzet per zaal</h2>
                    <div class="chart-card">
                        <MudChart ChartType="ChartType.Bar"
                                  ChartSeries="@_roomSeries"
                                  XAxisLabels="@_roomLabels"
                                  Width="100%"
                                  Height="350px">
                        </MudChart>
                    </div>
                </div>
            }

            @if (_revenueSplitData.Length > 0)
            {
                <div class="chart-section">
                    <h2>Tickets vs. popcorn</h2>
                    <div class="chart-card">
                        <MudChart ChartType="ChartType.Pie"
                                  InputData="@_revenueSplitData"
                                  InputLabels="@_revenueSplitLabels"
                                  Width="100%"
                                  Height="350px">
                        </MudChart>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>Geen omzetgegevens gevonden.</p>
        </div>
    }
</div>

<style>
    .analytics-container {
        max-width: 1400px;
        margin: 2rem auto;
        padding: 0 1.5rem;
    }

    .header-section {
        margin-bottom: 2rem;
    }

    .return-button {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: var(--text-high);
        padding: 0.75rem 1rem;
        margin-bottom: 1.5rem;
        border-radius: 999px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }

    .return-button:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(225, 29, 72, 0.35);
        transform: translateY(-1px);
    }

    .return-button:focus {
        outline: none;
        border-color: var(--primary-rose);
        box-shadow: 0 0 0 4px rgba(225, 29, 72, 0.12);
    }

    .return-button-icon {
        font-size: 1rem;
        line-height: 1;
    }

    .subtitle {
        color: var(--text-muted);
    }


    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }

    .stat-card {
        background: var(--surface-glass);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 1rem;
    }

    .stat-value {
        margin-top: 0.5rem;
        font-weight: 700;
        color: var(--text-high);
    }

    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 0;
        gap: 1.5rem;
    }

    .loading-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid rgba(255, 255, 255, 0.1);
        border-top-color: var(--primary-rose);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .charts-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-top: 2rem;
    }

    @@media (max-width: 900px) {
        .charts-grid {
            grid-template-columns: 1fr;
        }
    }

    .chart-section {
    }

    .chart-section h2 {
        font-size: 1.4rem;
        margin-bottom: 1rem;
        color: var(--text-high);
    }

    .chart-card {
        background: var(--surface-glass);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 1.5rem;
        backdrop-filter: blur(10px);
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: var(--text-muted);
        background: var(--surface-glass);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
    }
</style>

@code {
    private bool _isLoading;
    private RevenueAnalyticsResponseDto? _data;
    private List<ChartSeries> _series = new();
    private string[] _xAxisLabels = Array.Empty<string>();
    private List<ChartSeries> _movieSeries = new();
    private string[] _movieLabels = Array.Empty<string>();
    private List<ChartSeries> _roomSeries = new();
    private string[] _roomLabels = Array.Empty<string>();
    private double[] _revenueSplitData = Array.Empty<double>();
    private string[] _revenueSplitLabels = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;

        try
        {
            var filter = new AnalyticsPeriodRequestDto(DateTime.MinValue, DateTime.MaxValue, "day");
            _data = await RevenueAnalyticsService.GetRevenueAsync(filter);
            BuildChart();
        }
        catch
        {
            _data = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void BuildChart()
    {
        if (_data?.Items is { Count: > 0 })
        {
            _xAxisLabels = _data.Items.Select(i => i.Label).ToArray();
            _series = new List<ChartSeries>
            {
                new ChartSeries
                {
                    Name = "Omzet",
                    Data = _data.Items.Select(i => (double)i.Revenue).ToArray()
                }
            };
        }
        else
        {
            _series = new();
            _xAxisLabels = Array.Empty<string>();
        }

        if (_data?.TopMovies is { Count: > 0 })
        {
            _movieLabels = _data.TopMovies.Select(m => m.Label).ToArray();
            _movieSeries = new List<ChartSeries>
            {
                new ChartSeries
                {
                    Name = "Omzet",
                    Data = _data.TopMovies.Select(m => (double)m.Revenue).ToArray()
                }
            };
        }
        else
        {
            _movieSeries = new();
            _movieLabels = Array.Empty<string>();
        }

        if (_data?.RevenuePerRoom is { Count: > 0 })
        {
            _roomLabels = _data.RevenuePerRoom.Select(r => r.Label).ToArray();
            _roomSeries = new List<ChartSeries>
            {
                new ChartSeries
                {
                    Name = "Omzet",
                    Data = _data.RevenuePerRoom.Select(r => (double)r.Revenue).ToArray()
                }
            };
        }
        else
        {
            _roomSeries = new();
            _roomLabels = Array.Empty<string>();
        }

        if (_data is not null && (_data.TicketRevenue > 0 || _data.PopcornRevenue > 0))
        {
            _revenueSplitData = new[] { (double)_data.TicketRevenue, (double)_data.PopcornRevenue };
            _revenueSplitLabels = new[] { $"Tickets ({FormatCurrency(_data.TicketRevenue)})", $"Popcorn ({FormatCurrency(_data.PopcornRevenue)})" };
        }
        else
        {
            _revenueSplitData = Array.Empty<double>();
            _revenueSplitLabels = Array.Empty<string>();
        }
    }

    private static string FormatCurrency(decimal amount)
    {
        return $"\u20AC {amount:N2}";
    }
}


