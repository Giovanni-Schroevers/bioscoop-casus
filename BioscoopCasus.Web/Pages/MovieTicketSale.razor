@page "/movies/{MovieId}/ticketsale/{ShowtimeId}"
@page "/movies/{MovieId}/ticketsale/{ShowtimeId}/{ReturnUrl}"
@using System.Globalization
@inject IStringLocalizer<SharedResource> L

@inject NavigationManager NavigationManager
@inject MovieInformationService MovieInformationService
@inject TicketPricingService TicketPricingConfigService
@inject PaymentStateService PaymentStateService
@using BioscoopCasus.Web.Layout

<TerminalShell>
<div class="movies-page">
<div class="movie-details-wrapper">
    <button class="return-button" @onclick="GoBackToOverview">
        <span class="return-button-icon">&larr;</span>
        <span>@L["BackToMovies"]</span>
    </button>
<h1>@L["BuyTicketsTitle"]</h1>

@if (_isLoading)
{
    <p class="empty-message">@L["Loading"]</p>
}
else if (_movieInfo == null)
{
    <p class="empty-message">@L["MovieInfoLoadFailed"]</p>
}
else
{
    <div class="ticket-card">

        <div class="movie-info">
            <h2>@_movieInfo.Title</h2>
            <p>@_showtime.ToString("dddd dd MMMM HH:mm", CultureInfo.CurrentCulture)</p>
        </div>

        <div class="ticket-section">
            <div class="ticket-row">
                <span>@L["TicketTypeNormal"]</span>
                <input type="number" min="0" @bind="_normalTickets" @bind:event="oninput" />
                <span>@((_normalTickets * NormalPrice).ToString("C", CultureInfo.CurrentCulture))</span>
            </div>

            <div class="ticket-row">
                <span>@L["TicketTypeChild"]</span>
                <input type="number" min="0" @bind="_childTickets" @bind:event="oninput" />
                <span>@((_childTickets * ChildPrice).ToString("C", CultureInfo.CurrentCulture))</span>
            </div>

            <div class="ticket-row">
                <span>@L["TicketTypeStudent"]</span>
                <input type="number" min="0" @bind="_studentTickets" @bind:event="oninput" />
                <span>@((_studentTickets * StudentPrice).ToString("C", CultureInfo.CurrentCulture))</span>
            </div>

            <div class="ticket-row">
                <span>@L["TicketTypeSenior"]</span>
                <input type="number" min="0" @bind="_seniorTickets" @bind:event="oninput" />
                <span>@((_seniorTickets * SeniorPrice).ToString("C", CultureInfo.CurrentCulture))</span>
            </div>
        </div>

        <div class="voucher-section">
            <label>
                <input type="checkbox" @bind="_useVoucher"/>
                @L["UseVoucher"]
            </label>

            @if (_useVoucher)
            {
                <input class="voucher-input" placeholder="@L["VoucherCodePlaceholder"]"/>
            }
        </div>

        <div class="popcorn-section">
            <h3>@L["PopcornTitle"]</h3>

            @foreach (var item in _popcornItems)
            {
                var index = _popcornItems.IndexOf(item);
                <div class="popcorn-item">
                    <div class="popcorn-item-header">
                        <span class="popcorn-item-number">@L["PopcornItem"] @(index + 1)</span>
                        <button class="popcorn-remove" @onclick="@(() => _popcornItems.Remove(item))">✕</button>
                    </div>

                    <div class="popcorn-row">
                        <label>@L["PopcornSizeLabel"]</label>
                        <select @bind="item.Size">
                            <option value="small">@L["PopcornSmall"] — @TicketPricingConfigService.GetPopcornPrice("small").ToString("C", CultureInfo.CurrentCulture)</option>
                            <option value="medium">@L["PopcornMedium"] — @TicketPricingConfigService.GetPopcornPrice("medium").ToString("C", CultureInfo.CurrentCulture)</option>
                            <option value="large">@L["PopcornLarge"] — @TicketPricingConfigService.GetPopcornPrice("large").ToString("C", CultureInfo.CurrentCulture)</option>
                        </select>
                    </div>

                    <div class="popcorn-row">
                        <label>@L["PopcornFlavor"]</label>
                        <select @bind="item.Flavor">
                            <option value="sweet">@L["FlavorSweet"]</option>
                            <option value="salty">@L["FlavorSalty"]</option>
                            <option value="mix">@L["FlavorMix"]</option>
                            <option value="caramel">@L["FlavorCaramel"]</option>
                        </select>
                    </div>

                    <div class="popcorn-extras">
                        <label>
                            <input type="checkbox" @bind="item.AddDrink" />
                            @L["PopcornAddDrink"] (+@TicketPricingConfigService.GetDrinkPrice().ToString("C", CultureInfo.CurrentCulture))
                        </label>

                        @if (HasIntermission)
                        {
                            <label>
                                <input type="checkbox" @bind="item.AddRefill" />
                                @L["PopcornAddRefill"] (+@TicketPricingConfigService.GetRefillPrice().ToString("C", CultureInfo.CurrentCulture))
                            </label>
                        }
                    </div>
                </div>
            }

            <button class="popcorn-add-button" @onclick="@(() => _popcornItems.Add(new PopcornItem()))">
                + @L["PopcornAdd"]
            </button>
        </div>

        <div class="total-section">
            <span>@L["Total"]</span>
            <strong>@TotalPrice.ToString("C", CultureInfo.CurrentCulture)</strong>
        </div>

        @if (_validationError != null)
        {
            <p class="error-message">@_validationError</p>
        }

        <button class="buy-button" @onclick="BuyTickets">
            @L["ContinueToSeatSelection"]
        </button>

    </div>
}

</div>
</div>
</TerminalShell>

@code {

[Parameter] 
    public string MovieId { get; set; } = string.Empty;
[Parameter]
    public string ShowtimeId { get; set; }  = string.Empty;
[Parameter]
    public string? ReturnUrl { get; set; }

private bool _isLoading = true;
private string? _validationError;

private MovieResponseDto? _movieInfo;
private DateTime _showtime;

private int _normalTickets;
private int _childTickets;
private int _studentTickets;
private int _seniorTickets;

private bool _useVoucher;

private List<PopcornItem> _popcornItems = new();

private class PopcornItem
{
    public string Size { get; set; } = "small";
    public string Flavor { get; set; } = "sweet";
    public bool AddDrink { get; set; }
    public bool AddRefill { get; set; }
}

private int _movieDurationMinutes;
// TODO: Pass parameter for a movie being 3D
private const bool IsThreeD = false; // There is no property being passed for 3D yet, so it's always false


/*
 LOAD MOVIE DATA
*/

protected override async Task OnInitializedAsync()
{
    await LoadMovieInformation();
}

private void GoBackToOverview()
{
    NavigationManager.NavigateTo(ReturnUrl ?? "/movies");
}

private async Task LoadMovieInformation()
{
    try
    {
        var movieTask = MovieInformationService.GetMovieInformationAsync(MovieId);
        var timeoutTask = Task.Delay(5000);

        var completedTask = await Task.WhenAny(movieTask, timeoutTask);

        if (completedTask == movieTask)
        {
            _movieInfo = await movieTask;

            if (_movieInfo != null)
            {
                _movieDurationMinutes = _movieInfo.DurationMinutes;

                var showtime = _movieInfo.Showtimes?
                    .FirstOrDefault(s => s.Id.ToString() == ShowtimeId);

                if (showtime != null)
                    _showtime = showtime.StartTime;
            }
        }
    }
    catch
    {
        _movieInfo = null;
    }

    _isLoading = false;
}


/*
 BASE PRICE FROM CONFIG SERVICE
*/

private decimal BaseTicketPrice
{
    get
    {
        var price = TicketPricingConfigService
            .GetBasePrice(_movieDurationMinutes);

        // Always false, no parameter is being passed for 3D yet.
        if (IsThreeD)
            price += TicketPricingConfigService.GetThreeDSurcharge();

        return price;
    }
}

private bool IsChildDiscountValid =>
    TicketPricingConfigService.IsChildDiscountValid(_showtime);

private bool IsStudentDiscountValid =>
    TicketPricingConfigService.IsStudentDiscountValid(_showtime);

private bool IsSeniorDiscountValid =>
    TicketPricingConfigService.IsSeniorDiscountValid(_showtime);

private bool IsVoucherValid =>
    TicketPricingConfigService.IsVoucherValid(_showtime);

private bool HasIntermission =>
    TicketPricingConfigService.HasIntermission(_movieDurationMinutes);


/*
 FINAL PRICES
*/

private decimal NormalPrice => BaseTicketPrice;

private decimal ChildPrice =>
    IsChildDiscountValid
        ? BaseTicketPrice - TicketPricingConfigService.GetChildDiscount()
        : BaseTicketPrice;

private decimal StudentPrice =>
    IsStudentDiscountValid
        ? BaseTicketPrice - TicketPricingConfigService.GetStudentDiscount()
        : BaseTicketPrice;

private decimal SeniorPrice =>
    IsSeniorDiscountValid
        ? BaseTicketPrice - TicketPricingConfigService.GetSeniorDiscount()
        : BaseTicketPrice;


private decimal PopcornTotal => _popcornItems.Sum(item =>
{
    var total = TicketPricingConfigService.GetPopcornPrice(item.Size);
    if (item.AddDrink) total += TicketPricingConfigService.GetDrinkPrice();
    if (item.AddRefill && HasIntermission) total += TicketPricingConfigService.GetRefillPrice();
    return total;
});

private decimal TotalPrice
{
    get
    {
        var total =
            _normalTickets * NormalPrice +
            _childTickets * ChildPrice +
            _studentTickets * StudentPrice +
            _seniorTickets * SeniorPrice +
            PopcornTotal;

        if (_useVoucher && IsVoucherValid)
        {
            total -= 10m; // voucher example
        }

        return Math.Max(total, 0);
    }
}


/*
 PURCHASE
*/

private void BuyTickets()
{
    _validationError = null;

    if (TotalTickets == 0)
    {
        _validationError = L["ValidationSelectAtLeastOneTicket"];
        return;
    }

    if (_useVoucher && !IsVoucherValid)
    {
        _validationError = L["ValidationVoucherInvalidTime"];
        return;
    }

    // Store price in memory — never in the URL
    PaymentStateService.SetPrice((int)(TotalPrice * 100));

    NavigationManager.NavigateTo(
        $"/seat-reservation/{MovieId}/{ShowtimeId}/{TotalTickets}");
}

private int TotalTickets =>
    _normalTickets +
    _childTickets +
    _studentTickets +
    _seniorTickets;

}