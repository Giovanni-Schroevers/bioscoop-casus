@page "/payment"
@page "/payment/{MovieTitle}"
@using System.Globalization
@inject PaymentService PaymentService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> L
@inject PaymentStateService PaymentStateService
@inject CheckoutStateService CheckoutStateService
@inject ReservationService ReservationService

<div class="pin-page">
    <h1>@L["PaymentTitle"]</h1>

    @if (TotalPriceCents > 0)
    {
        <div class="amount-display">
            <span class="amount-label">@L["AmountDue"]</span>
            <span class="amount-value">@TotalPriceFormatted</span>
        </div>
    }

    @if (!_paymentDone)
    {
        <div class="payment-options">
            <div class="pin-section">
                <h2>@L["PinTitle"]</h2>

                <div class="pin-display">
                    @for (int i = 0; i < 4; i++)
                    {
                        <span class="pin-dot">@(i < EnteredPin.Length ? "*" : "-")</span>
                    }
                </div>

                <div class="pin-pad">
                    @for (int i = 1; i <= 9; i++)
                    {
                        var digit = i.ToString();
                        <button class="pin-button" @onclick="() => AddDigit(digit)">@digit</button>
                    }
                    <button class="pin-button clear" @onclick="Clear">C</button>
                    <button class="pin-button" @onclick="() => AddDigit('0'.ToString())">0</button>
                    <button class="pin-button confirm" @onclick="Submit">OK</button>
                </div>

            </div>

            <div class="qr-section">
                <h2>@L["QrPaymentTitle"]</h2>
                <p class="qr-info">@L["QrPaymentInfo"]</p>
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=http://localhost:5158/betalen"
                     alt="@L["QrCodeAlt"]" />
            </div>
        </div>

        <div class="email-section">
            <label for="email">@L["EmailLabel"]</label>
            <input id="email" type="email" placeholder="@L["EmailPlaceholder"]" @bind="_email" @bind:event="oninput" />
            @if (_emailError != null)
            {
                <p class="email-error">@_emailError</p>
            }
        </div>
    }
    else
    {
        <div class="payment-success">
            <div class="success-icon">&#10003;</div>
            <h2>@L["PaymentSuccessTitle"]</h2>
            @if (TotalPriceCents > 0)
            {
                <p>@L["AmountPaid", TotalPriceFormatted]</p>
            }
            <p class="success-sub">@L["PaymentThanks"]</p>
            
            @if (!string.IsNullOrEmpty(MovieTitle))
            {
                <div class="social-share">
                    <p>@L["ShareExcitement"]</p>
                    <div class="share-buttons">
                        <a href="https://x.com/intent/post?text=@(Uri.EscapeDataString(L["ShareMessage", MovieTitle]))"
                           target="_blank" rel="noopener noreferrer" class="share-button x-share">
                            <svg viewBox="0 0 24 24" aria-hidden="true" class="share-icon"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
                            <span>@L["ShareOnX"]</span>
                        </a>
                        <a href="https://wa.me/?text=@(Uri.EscapeDataString(L["ShareMessage", MovieTitle]))"
                           target="_blank" rel="noopener noreferrer" class="share-button wa-share">
                            <svg viewBox="0 0 24 24" aria-hidden="true" class="share-icon"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12.001 20c-1.465 0-2.846-.394-4.04-1.082l-4.226 1.107 1.127-4.12A7.962 7.962 0 0 1 4.001 12c0-4.418 3.582-8 8-8s8 3.582 8 8-3.582 8-8 8zm0-18C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.435 5.176L2 22l4.957-1.298C8.351 21.54 10.111 22 12.001 22c5.523 0 10-4.477 10-10S17.524 2 12.001 2z"></path></svg>
                            <span>@L["ShareOnWhatsApp"]</span>
                        </a>
                    </div>
                </div>
            }

            <button class="home-button" @onclick="GoHome">@L["BackToMovies"]</button>
        </div>
    }

    @if (Message != null)
    {
        <p class="pin-message @(IsSuccess ? "success" : "error")">@Message</p>
    }
</div>

<style>
.amount-display {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 24px;
}

.amount-label {
    font-size: .9rem;
    color: #aaa;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.amount-value {
    font-size: 2.4rem;
    font-weight: bold;
    color: #fff;
}

.payment-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 40px 0;
}

.success-icon {
    width: 72px;
    height: 72px;
    background: #28a745;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: white;
}

.success-sub {
    color: #aaa;
    font-size: .95rem;
}

.home-button {
    margin-top: 16px;
    background: #e50914;
    color: white;
    border: none;
    padding: 12px 28px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1rem;
}

.social-share {
    margin-top: 24px;
    text-align: center;
}

.social-share p {
    color: #ccc;
    font-size: 0.9rem;
    margin-bottom: 12px;
}

.share-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
}

.share-button {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.share-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    color: white;
}

.share-icon {
    width: 20px;
    height: 20px;
    fill: currentColor;
}

.x-share {
    background-color: #000;
    color: white;
}

.x-share:hover {
    background-color: #333;
}

.wa-share {
    background-color: #25D366;
    color: white;
}

.wa-share:hover {
    background-color: #128C7E;
}

.email-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: 32px;
    margin-bottom: 24px;
}

.email-section label {
    font-size: .9rem;
    color: #aaa;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.email-section input {
    padding: 10px 16px;
    border-radius: 6px;
    border: 1px solid #444;
    background: #1a1f2b;
    color: white;
    font-size: 1rem;
    width: 300px;
    text-align: center;
}

.email-error {
    color: #ff6b6b;
    font-size: .85rem;
    margin: 0;
}
</style>

@code {
    [Parameter] public int TotalPriceCents { get; set; }  // kept for interface compat — value comes from PaymentStateService
    [Parameter] public string? MovieTitle { get; set; }
    
    private string EnteredPin = "";
    private string? Message;
    private bool IsSuccess;
    private bool _paymentDone;
    private string _email = "";
    private string? _emailError;

    protected override async Task OnInitializedAsync()
    {
        if (!CheckoutStateService.HasActiveCheckout)
        {
            NavigationManager.NavigateTo("/films");
            return;
        }

        // Example values
        var showtimeId = CheckoutStateService.ShowtimeId!.Value;
        var selectedSeatIds = CheckoutStateService.SelectedSeatIds;
        var movieTitle = CheckoutStateService.MovieTitle;
        var showtimeDisplay = CheckoutStateService.ShowtimeDisplay;
        var popcornOrders = CheckoutStateService.PopcornOrders;
        var totalPriceCents = CheckoutStateService.TotalPriceCents;
    }
    
    protected override void OnInitialized()
    {
        // Price is read from the state service — it was never in the URL
        TotalPriceCents = PaymentStateService.TotalPriceCents;
    }

    private string TotalPriceFormatted =>
        (TotalPriceCents / 100m).ToString("C", CultureInfo.CurrentCulture);

    private void AddDigit(string digit)
    {
        if (EnteredPin.Length < 4)
        {
            EnteredPin += digit;
            Message = null;
        }
    }

    private void Clear()
    {
        EnteredPin = "";
        Message = null;
    }

    private async Task Submit()
    {
        _emailError = null;

        if (string.IsNullOrWhiteSpace(_email) || !_email.Contains('@') || !_email.Contains('.'))
        {
            _emailError = L["EmailRequired"];
            return;
        }

        if (EnteredPin.Length != 4)
        {
            Message = L["EnterFourDigits"];
            IsSuccess = false;
            return;
        }

        IsSuccess = await PaymentService.ValidatePinAsync(EnteredPin);
        EnteredPin = "";

        if (IsSuccess)
        {
            Message = null;
            _paymentDone = await CompletePaymentAsync();
            if (!_paymentDone)
                Message = "Error";
        }
        else
        {
            Message = L["InvalidPinTryAgain"];
        }
    }
    
    private async Task<bool> CompletePaymentAsync()
    {
        if (!CheckoutStateService.HasActiveCheckout || !CheckoutStateService.ShowtimeId.HasValue)
        {
            NavigationManager.NavigateTo("/films");
            return false;
        }

        var confirmationResult =
            await ReservationService.ConfirmReservationAsync(
                CheckoutStateService.ShowtimeId.Value,
                CheckoutStateService.SelectedSeatIds,
                CheckoutStateService.PopcornOrders,
                CheckoutStateService.TotalPriceCents / 100m);

        if (confirmationResult != null)
        {
            var success = await PaymentService.SendReservationEmail(_email, confirmationResult.ReservationId);
            if(success)
                CheckoutStateService.Clear();

            return success;
        }

        NavigationManager.NavigateTo("/films");
        return false;
    }

    private void GoHome()
    {
        NavigationManager.NavigateTo("/movies");
    }
}
